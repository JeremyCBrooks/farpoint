{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Farpoint normalised credential import",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "exposures": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exposure"
      }
    },
    "summaries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/summary"
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/check"
      }
    }
  },
  "$defs": {
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "operation",
        "reference",
        "scope_domain",
        "query_kind"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "provider_record_id": {
          "type": "string",
          "minLength": 1
        },
        "reference": {
          "type": "string",
          "minLength": 1
        },
        "scope_domain": {
          "type": "string",
          "minLength": 1
        },
        "query_kind": {
          "enum": [
            "email",
            "website"
          ]
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "identity": {
          "type": "string",
          "minLength": 1
        },
        "provider_relationship": {
          "type": "string",
          "minLength": 1
        },
        "service_host": {
          "type": "string",
          "minLength": 1
        },
        "service_port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535
        },
        "exposure_type": {
          "enum": [
            "breach",
            "infostealer",
            "phishing",
            "combolist",
            "unknown"
          ]
        },
        "source_name": {
          "type": "string",
          "minLength": 1
        },
        "source_event_id": {
          "type": "string",
          "minLength": 1
        },
        "malware_family": {
          "type": "string",
          "minLength": 1
        },
        "secret_types": {
          "type": "array",
          "items": {
            "enum": [
              "password",
              "password-hash",
              "session-cookie",
              "access-token",
              "security-question",
              "other"
            ]
          }
        },
        "secret_evidence": {
          "enum": [
            "record",
            "dataset"
          ]
        },
        "event_at": {
          "type": "string",
          "description": "ISO 8601 date (YYYY-MM-DD) or date-time; a time with an offset is stored as UTC"
        },
        "event_date_basis": {
          "enum": [
            "breach",
            "compromised",
            "captured",
            "published",
            "uploaded",
            "unknown"
          ]
        },
        "provider_discovered_at": {
          "type": "string",
          "description": "ISO 8601 date (YYYY-MM-DD) or date-time; a time with an offset is stored as UTC"
        },
        "source_observed_at": {
          "type": "string",
          "description": "ISO 8601 date (YYYY-MM-DD) or date-time; a time with an offset is stored as UTC"
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "operation",
        "metric",
        "count",
        "scope_domain",
        "query_kind"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "scope_domain": {
          "type": "string",
          "minLength": 1
        },
        "query_kind": {
          "enum": [
            "email",
            "website"
          ]
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "metric": {
          "type": "string",
          "minLength": 1
        },
        "population": {
          "type": "string",
          "minLength": 1
        },
        "count": {
          "type": "integer",
          "minimum": 0
        },
        "window_start": {
          "type": "string",
          "description": "ISO 8601 date (YYYY-MM-DD) or date-time; a time with an offset is stored as UTC"
        },
        "window_end": {
          "type": "string",
          "description": "ISO 8601 date (YYYY-MM-DD) or date-time; a time with an offset is stored as UTC"
        },
        "reference": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "operation",
        "status",
        "scope_domain",
        "query_kind"
      ],
      "properties": {
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "scope_domain": {
          "type": "string",
          "minLength": 1
        },
        "query_kind": {
          "enum": [
            "email",
            "website"
          ]
        },
        "operation": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "complete",
            "partial",
            "unavailable",
            "unsupported",
            "failed",
            "interrupted"
          ]
        },
        "error": {
          "enum": [
            "no-key",
            "denied",
            "quota",
            "transport",
            "server",
            "schema"
          ]
        },
        "checked_at": {
          "type": "string",
          "description": "ISO 8601 date (YYYY-MM-DD) or date-time; a time with an offset is stored as UTC"
        }
      }
    }
  }
}
