{
 "_comment": "Technology rules for farpoint.fingerprint. Each rule matches if any matcher does; a regex's first group, if any, is the version. Matchers: header+regex, cookie (cookie names), title, body, location, banner, cname, generator (<meta name=generator>), cert (certificate subject/issuer). Regexes are case-insensitive.",
 "rules": [
  {
   "name": "FortiGate SSL-VPN",
   "category": "edge",
   "match": [
    {
     "location": "/remote/login"
    },
    {
     "body": "/remote/login\\?lang=|fgt_lang|/sslvpn/portal\\.html"
    },
    {
     "cookie": "^SVPNCOOKIE$|^SVPNNETWORKCOOKIE$"
    },
    {
     "title": "^FortiGate|SSL VPN Portal"
    }
   ]
  },
  {
   "name": "Fortinet FortiWeb/FortiMail/FortiManager",
   "category": "edge",
   "match": [
    {
     "title": "^(FortiWeb|FortiMail|FortiManager|FortiAnalyzer|FortiADC|FortiProxy|FortiSIEM)"
    },
    {
     "cert": "\\bFortinet\\b|\\bFortiGate\\b"
    }
   ]
  },
  {
   "name": "Palo Alto GlobalProtect",
   "category": "edge",
   "match": [
    {
     "location": "/global-protect/login\\.esp"
    },
    {
     "body": "global-protect/login\\.esp|GlobalProtect Portal"
    },
    {
     "title": "GlobalProtect"
    }
   ]
  },
  {
   "name": "Palo Alto PAN-OS management",
   "category": "edge",
   "match": [
    {
     "body": "Pan\\.base\\.|/js/Pan\\.js"
    }
   ]
  },
  {
   "name": "Citrix NetScaler Gateway",
   "category": "edge",
   "match": [
    {
     "location": "/vpn/index\\.html|/logon/LogonPoint/"
    },
    {
     "body": "/vpn/index\\.html|/logon/LogonPoint/|ctxs\\.core\\.min\\.js"
    },
    {
     "title": "Citrix Gateway|NetScaler Gateway|NetScaler AAA"
    }
   ]
  },
  {
   "name": "Citrix NetScaler ADC",
   "category": "edge",
   "match": [
    {
     "cookie": "^NSC_"
    },
    {
     "header": "via",
     "regex": "NS-CACHE"
    },
    {
     "header": "cneonction",
     "regex": "."
    }
   ]
  },
  {
   "name": "F5 BIG-IP",
   "category": "edge",
   "match": [
    {
     "cookie": "^BIGipServer|^F5_ST$|^MRHSession$|^LastMRH_Session$|^TS[0-9a-f]{6,8}$"
    },
    {
     "header": "server",
     "regex": "^BigIP|^BIG-IP"
    },
    {
     "body": "/my\\.policy|/tmui/login\\.jsp|F5 Networks"
    }
   ]
  },
  {
   "name": "F5 BIG-IP APM",
   "category": "edge",
   "match": [
    {
     "cookie": "^MRHSession$|^LastMRH_Session$|^F5_ST$"
    },
    {
     "location": "/my\\.policy"
    },
    {
     "body": "/my\\.policy"
    }
   ]
  },
  {
   "name": "Cisco ASA / AnyConnect",
   "category": "edge",
   "match": [
    {
     "location": "/\\+CSCOE\\+/"
    },
    {
     "body": "/\\+CSCOE\\+/|/\\+CSCOT\\+/"
    },
    {
     "cookie": "^webvpn"
    }
   ]
  },
  {
   "name": "Ivanti Connect Secure",
   "category": "edge",
